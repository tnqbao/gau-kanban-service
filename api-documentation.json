  "components": {
    "schemas": {
      "CreateColumnRequest": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Column title"
          }
        }
      },
      "UpdateColumnRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Column title"
          },
          "position": {
            "type": "integer",
            "description": "Column position"
          }
        }
      },
      "ChangeColumnPositionRequest": {
        "type": "object",
        "required": ["new_position"],
        "properties": {
          "new_position": {
            "type": "integer",
            "minimum": 1,
            "description": "New position for the column (1-based). Use 1 for first position, or a large number for last position (auto-adjusts)"
          }
        }
      },
      "ColumnResponse": {
        "type": "object",
