  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "CreateBoardRequest": {
        "type": "object",
        "required": ["title", "fullname"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Board title"
          },
          "description": {
            "type": "string",
            "description": "Board description"
          },
          "fullname": {
            "type": "string",
            "description": "Full name of the board creator"
          }
        }
      },
      "UpdateBoardRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CreateMemberRequest": {
        "type": "object",
        "required": ["board_id", "member_id", "full_name"],
        "properties": {
          "board_id": {
            "type": "string",
            "format": "uuid"
          },
          "member_id": {
            "type": "string",
            "format": "uuid"
          },
          "full_name": {
            "type": "string"
          }
        }
      },
      "UpdateMemberRequest": {
        "type": "object",
        "properties": {
          "full_name": {
            "type": "string"
          }
        }
      },
      "CreateColumnRequest": {
        "type": "object",
        "required": ["title", "board_id"],
        "properties": {
          "title": {
            "type": "string"
