    "/tickets/{id}/change-position": {
      "put": {
        "summary": "Change ticket position (Advanced)",
        "description": "Changes ticket position with advanced handling - supports moving within same column or between different columns. Handles first, last, and middle positions automatically.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeTicketPositionRequest"
              },
              "examples": {
                "move_within_column": {
                  "summary": "Move to top of same column",
                  "value": {
                    "new_column_id": "same-column-uuid",
                    "new_position": 1
                  }
                },
                "move_between_columns": {
                  "summary": "Move to different column",
                  "value": {
                    "new_column_id": "different-column-uuid",
                    "new_position": 2
                  }
                },
                "move_to_end": {
                  "summary": "Move to end of column",
                  "value": {
                    "new_column_id": "target-column-uuid",
                    "new_position": 999
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket position changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TicketPositionChangeResponse"
                }
              }
            }
          }
        },
        "tags": ["Tickets", "Position Management"]
      }
    },
