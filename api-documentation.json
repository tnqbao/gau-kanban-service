{
  "openapi": "3.0.0",
  "info": {
    "title": "Kanban Service API",
    "description": "Comprehensive API documentation for the Kanban Service with advanced position management",
    "version": "2.0.0",
    "contact": {
      "name": "Kanban Service Team"
    }
  },
  "servers": [
    {
      "url": "/api/v2/kanban",
      "description": "Kanban API v2"
    }
  ],
  "paths": {
    "/columns": {
      "post": {
        "summary": "Create a new column",
        "description": "Creates a new kanban column and automatically assigns it the next position",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateColumnRequest"
              },
              "example": {
                "title": "To Do"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Column created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColumnResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body"
          },
          "500": {
            "description": "Internal server error"
          }
        },
        "tags": ["Columns"]
      },
      "get": {
        "summary": "Get all columns with tickets",
        "description": "Retrieves all columns ordered by position, including their tickets with labels, assignees, and metadata",
        "responses": {
          "200": {
            "description": "Columns retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ColumnWithTicketsDTO"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": ["Columns"]
      }
    },
    "/columns/{id}": {
      "get": {
        "summary": "Get column by ID",
        "description": "Retrieves a specific column with all its tickets and details",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Column ID"
          }
