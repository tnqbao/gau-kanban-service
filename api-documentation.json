        "responses": {
          "200": {
            "description": "Column retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ColumnWithTicketsDTO"
                }
              }
            }
          },
          "404": {
            "description": "Column not found"
          }
        },
        "tags": ["Columns"]
      },
      "put": {
        "summary": "Update column",
        "description": "Updates column title and/or position",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateColumnRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Column updated successfully"
          },
          "404": {
            "description": "Column not found"
          }
        },
        "tags": ["Columns"]
      },
      "delete": {
        "summary": "Delete column",
        "description": "Deletes a column and all its tickets",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Column deleted successfully"
          },
          "404": {
            "description": "Column not found"
          }
        },
        "tags": ["Columns"]
      }
    },
    "/columns/{id}/change-position": {
      "put": {
        "summary": "Change column position (Advanced)",
        "description": "Changes column position with smart handling - supports moving to first, last, or any middle position. Automatically shifts other columns.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangeColumnPositionRequest"
              },
              "examples": {
                "move_to_first": {
                  "summary": "Move to first position",
                  "value": {
                    "new_position": 1
                  }
                },
                "move_to_middle": {
                  "summary": "Move to middle position",
                  "value": {
                    "new_position": 3
                  }
                },
                "move_to_last": {
                  "summary": "Move to last position (auto-adjusts)",
                  "value": {
                    "new_position": 999
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Column position changed successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PositionChangeResponse"
                }
              }
            }
          }
        },
        "tags": ["Columns", "Position Management"]
      }
    },
